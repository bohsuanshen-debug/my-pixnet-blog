# ==========================================
# 痞客邦 (Pixnet) -> Notion 搬家腳本設定
# ==========================================

# 1. 痞客邦 Sitemap 網址 (通常為 https://<你的痞客邦帳號>.pixnet.net/sitemap.xml)
PIXNET_SITEMAP_URL=https://example.pixnet.net/sitemap.xml

# 2. Notion 相關設定
# Notion API Token (Secret Key): 請至 https://www.notion.so/my-integrations 建立 Internal Integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID: 你的目標資料庫 ID (網址中 32 碼英數組合，例如 https://www.notion.so/workspace/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. 圖床服務設定 (首選推薦 ImgBB，亦支援 Cloudinary / Imgur)
# ========================================================
# [方案 A] 首選推薦：ImgBB (完全免費、免綁手機、支援 Google 一鍵登入、台灣連線順暢)
# 取得方式：
# 1. 前往 https://api.imgbb.com/ 點擊「取得 API 金鑰 (Get API Key)」
# 2. 直接以 Google 帳號一鍵登入，點擊新增金鑰，複製 32 碼 API Key
IMAGE_HOST_PROVIDER=imgbb
IMGBB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [方案 B] 備選：Cloudinary (支援高畫質與大容量備份，支援 Google 一鍵登入)
# 前往 https://cloudinary.com/ 註冊免費帳號取得以下資訊，並將上方 IMAGE_HOST_PROVIDER 改為 cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# [方案 C] Imgur (若先前已有帳號者可用)
# 將 IMAGE_HOST_PROVIDER 改為 imgur 並填寫 Client ID
IMGUR_CLIENT_ID=

# 4. 爬蟲延遲與安全保護設定 (秒)
REQUEST_DELAY_SECONDS=1.5
